# Copy to supabase/functions/.env for local development (that file is not committed). Local only: these values are
# public in this repository, so they must never be set on the live project.
SCANNER_PROVIDER=mock
SCAN_WEBHOOK_SECRET=local-development-only-scan-secret
NOTIFY_WEBHOOK_SECRET=local-development-only-notify-secret
NOTIFY_TRANSPORT=capture
SMOKE_WEBHOOK_SECRET=local-development-only-smoke-secret
